{
  "name": "hostspan",
  "version": "0.2.0-alpha.8",
  "description": "Terminal-first MCP execution gateway for approved local targets",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "hostspan": "./dist/src/cli/index.js"
  },
  "types": "./dist/src/index.d.ts",
  "files": ["dist/src", "docs", "examples"],
  "exports": {
    ".": "./dist/src/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run test/contract test/acceptance",
    "test:path": "vitest run test/files/path-security.test.ts",
    "doctor": "node dist/src/cli/index.js doctor",
    "smoke": "node dist/src/cli/index.js smoke",
    "lint": "biome lint src test",
    "check": "corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test && corepack pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/fastify": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "better-sqlite3": "13.0.3",
    "diff": "8.0.2",
    "fastify": "5.6.2",
    "pino": "9.9.5",
    "uuid": "13.0.0",
    "yaml": "2.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.7.2",
    "fast-check": "4.3.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@12.4.2"
}
