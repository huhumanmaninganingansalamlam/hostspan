{
  "name": "hostspan",
  "version": "0.2.0-alpha.22",
  "productName": "HostSpan",
  "desktopName": "HostSpan",
  "description": "Terminal-first MCP execution gateway for approved local targets",
  "author": "HostSpan contributors",
  "homepage": "https://github.com/huhumanmaninganingansalamlam/hostspan",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/huhumanmaninganingansalamlam/hostspan.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/src/desktop/main.js",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "hostspan": "./dist/src/cli/index.js"
  },
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src",
    "docs",
    "examples"
  ],
  "exports": {
    ".": "./dist/src/index.js"
  },
  "scripts": {
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.json",
    "icons": "node scripts/generate-icons.mjs",
    "desktop": "corepack pnpm build && corepack pnpm icons && electron dist/src/desktop/main.js",
    "desktop:dev": "corepack pnpm build && corepack pnpm icons && electron dist/src/desktop/main.js",
    "desktop:dir": "corepack pnpm build && corepack pnpm icons && node scripts/clean.mjs out && electron-builder --config electron-builder.yml --dir",
    "desktop:make": "corepack pnpm build && corepack pnpm icons && node scripts/clean.mjs out && electron-builder --config electron-builder.yml --publish never",
    "desktop:smoke": "node scripts/smoke-packaged-cli.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run test/contract test/acceptance",
    "test:path": "vitest run test/files/path-security.test.ts",
    "doctor": "node dist/src/cli/index.js doctor",
    "smoke": "node dist/src/cli/index.js smoke",
    "lint": "biome lint src test",
    "check": "corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test && corepack pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/fastify": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "better-sqlite3": "13.0.3",
    "diff": "8.0.2",
    "fastify": "5.6.2",
    "pino": "9.9.5",
    "uuid": "13.0.0",
    "yaml": "2.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@electron/asar": "3.4.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.7.2",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "fast-check": "4.3.0",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.4",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@12.4.2"
}
